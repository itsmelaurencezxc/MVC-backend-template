generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. ADMIN USER
model User {
  id           String @id @default(uuid())
  userEmail    String @unique
  userPassword String
  userContact  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

enum EmployeeRole {
  TRAINEE
  SENIOR
  HR
  SECRETARY
  OWNER
}

// 2. EMPLOYEE
model Employee {
  id            String       @id @default(uuid())
  name          String
  role          EmployeeRole @default(TRAINEE) // Default kapag walang nilagay
  discordId     String? // Discord ID o Username
  discordAvatar String? // Link ng profile picture sa Discord
  discordBanner String? // Link ng banner
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryRecords SalaryRecord[]

  @@map("employee")
}

// 3. PAYOUT PERIOD / WEEKLY CUT-OFF
model PayoutPeriod {
  id String @id @default(uuid())

  period    String
  startDate DateTime
  endDate   DateTime

  isCurrent Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryRecords SalaryRecord[]

  @@index([startDate, endDate])
  @@map("payout_period")
}

// 4. SALARY RECORD
model SalaryRecord {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  name String

  grossEarnings  Decimal @db.Decimal(12, 2)
  commissionRate Decimal @db.Decimal(5, 2)
  salary         Decimal @db.Decimal(12, 2)

  recmats   String?
  isClaimed Boolean   @default(false)
  deletedAt DateTime?

  payoutPeriodId String
  payoutPeriod   PayoutPeriod @relation(fields: [payoutPeriodId], references: [id], onDelete: Cascade)

  logs EarningsLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([payoutPeriodId])
  @@index([employeeId, payoutPeriodId])
  @@map("salary_record")
}

// 5. EARNINGS LOG (Optional kung gusto mo pang panatilihin sa schema)
model EarningsLog {
  id String @id @default(uuid())

  salaryRecordId String
  salaryRecord   SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  entryDate DateTime  @default(now())
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([salaryRecordId])
  @@index([entryDate])
  @@map("earnings_log")
}
