// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. ADMIN USER MODEL
model User {
  id           String    @id @default(uuid())
  userEmail    String    @unique
  userPassword String
  userContact  String
  createdAt    DateTime? @default(now())
  updateAt     DateTime? @updatedAt

  @@map("user")
}

// 2. PAYOUT PERIOD / SHEET TABS (e.g. "8.18.2026 - 8.25.2026")
model PayoutPeriod {
  id        String    @id @default(uuid())
  period    String // Pangalan ng cut-off / tab
  isCurrent Boolean   @default(true)
  deletedAt DateTime? // Soft Delete Tracker

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryRecords SalaryRecord[]

  @@map("payout_period")
}

// 3. SALARY BOARD ROW ENTRY
model SalaryRecord {
  id            String    @id @default(uuid())
  name          String
  grossEarnings Decimal   @db.Decimal(12, 2)
  salary        Decimal   @db.Decimal(12, 2)
  recmats       String? // Optional
  isClaimed     Boolean   @default(false)
  deletedAt     DateTime? // Soft Delete Tracker

  payoutPeriodId String // String ID na rin para tumugma sa PayoutPeriod.id
  payoutPeriod   PayoutPeriod @relation(fields: [payoutPeriodId], references: [id], onDelete: Cascade)

  logs EarningsLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("salary_record")
}

// 4. EARNINGS LOG ENTRY
model EarningsLog {
  id             String       @id @default(uuid())
  salaryRecordId String // String ID para tumugma sa SalaryRecord.id
  salaryRecord   SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)

  amount    Decimal   @db.Decimal(12, 2)
  entryDate DateTime  @default(now())
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@map("earnings_log")
}
