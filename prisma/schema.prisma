// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  userEmail    String    @unique
  userPassword String
  userContact  String
  createdAt    DateTime? @default(now())
  updateAt     DateTime? @updatedAt

  @@map("user")
}

model PayoutPeriod {
  id        Int       @id @default(autoincrement())
  period    String // Pangalan ng cut-off / tab
  isCurrent Boolean   @default(true) // Kung ito ang active tab
  deletedAt DateTime? // Soft Delete Tracker

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryRecords SalaryRecord[]

  @@map("payout_period")
}

model SalaryRecord {
  id            Int       @id @default(autoincrement())
  name          String
  grossEarnings Decimal   @db.Decimal(12, 2)
  salary        Decimal   @db.Decimal(12, 2) // Auto-computed via action
  recmats       String? // Optional (e.g., "5k")
  isClaimed     Boolean   @default(false) // Optional (Default is false / Unchecked)
  deletedAt     DateTime? // Soft Delete Tracker

  payoutPeriodId Int
  payoutPeriod   PayoutPeriod @relation(fields: [payoutPeriodId], references: [id], onDelete: Cascade)

  logs EarningsLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("salary_record")
}

model EarningsLog {
  id             Int          @id @default(autoincrement())
  salaryRecordId Int
  salaryRecord   SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)

  amount    Decimal   @db.Decimal(12, 2)
  entryDate DateTime  @default(now())
  deletedAt DateTime? // Soft Delete Tracker

  createdAt DateTime @default(now())

  @@map("earnings_log")
}
